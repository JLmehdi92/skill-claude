# Clé API kie.ai (https://kie.ai/api-key). Reste côté serveur, jamais envoyée au navigateur.
KIE_API_KEY=

# Filtre NSFW de kie.ai. false = désactivé par défaut (réactivable par génération dans "Avancé").
KIE_NSFW_CHECKER=false

# Taux USD -> EUR de secours si l'API de taux (BCE via frankfurter) ne répond pas.
USD_EUR_RATE=0.86

# 1 = faux client kie (aucun crédit dépensé), utile pour tester l'interface.
KIE_MOCK=0

# Dossier des données locales (base SQLite + médias).
STORAGE_DIR=storage
