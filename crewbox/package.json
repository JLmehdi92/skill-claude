{
  "name": "crewbox",
  "version": "0.1.0",
  "description": "Local, self-hosted AI coworkers: souls, skills, memory, apps (MCP), schedules, webhook triggers and human-in-the-loop approvals.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "crewbox": "src/cli.js"
  },
  "scripts": {
    "prestart": "node scripts/ensure-ui.js",
    "start": "node --disable-warning=ExperimentalWarning src/cli.js start",
    "build": "vite build --config web/vite.config.js",
    "dev:api": "CREWBOX_UI_TOKEN=dev node --disable-warning=ExperimentalWarning --watch src/cli.js start",
    "dev:ui": "vite --config web/vite.config.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "croner": "^10.0.1"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@vitejs/plugin-react": "^6.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^14.0.0",
    "ogl": "^1.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4"
  }
}
